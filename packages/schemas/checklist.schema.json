{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preshipos:schema:checklist.schema.json",
  "title": "PreShipOS Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "module",
    "status",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "module": {
      "enum": [
        "validate",
        "build",
        "check",
        "prepare",
        "launch",
        "distribute",
        "discover",
        "grow"
      ]
    },
    "status": {
      "enum": ["draft", "published", "archived"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "required"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "help_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
