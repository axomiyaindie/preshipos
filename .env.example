# PostgreSQL
POSTGRES_DB=preshipos
POSTGRES_USER=preshipos
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Database connection
DATABASE_URL=postgresql://preshipos:replace-with-a-strong-local-password@localhost:5432/preshipos

# Application URL — configure when the domain is decided
NEXT_PUBLIC_APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google OAuth — configure when credentials are available
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery — required for verification and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
